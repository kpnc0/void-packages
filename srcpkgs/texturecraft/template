# Template file for 'textcraft'
pkgname=texturecraft
version=0.4.0
revision=1
build_style=cargo
make_build_args="--bins"
depends="libxkbcommon vulkan-loader desktop-file-utils hicolor-icon-theme
 shared-mime-info xdg-utils zenity"
short_desc="TextureCraft is a native 3D texture painter written in Rust"
maintainer="kpnc0 <xpz4yx@gmail.com>"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps/texturecraft"
distfiles="https://github.com/storytold/texturecraft/archive/refs/tags/v${version}.tar.gz"
checksum=164c4b140ebdd956ecf3540f4cf9d10b38c0df8002d959ae5315259484905789

export CARGO_PROFILE_RELEASE_LTO=fat
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
export CARGO_PROFILE_RELEASE_OPT_LEVEL=3

do_build() {
    cargo auditable build --release --locked --target ${RUST_TARGET} \
        ${configure_args} --bins
}

do_install() {
    vbin target/${RUST_TARGET}/release/texturecraft
    vbin target/${RUST_TARGET}/release/texturecraft-cli

    vinstall packaging/linux/ai.storyteller.texturecraft.desktop 644 usr/share/applications
    vinstall packaging/linux/ai.storyteller.texturecraft.mime.xml 644 usr/share/mime/packages

    if [ -f assets/app-icon/hicolor/scalable/apps/ai.storyteller.texturecraft.svg ]; then
        vinstall assets/app-icon/hicolor/scalable/apps/ai.storyteller.texturecraft.svg \
            644 usr/share/icons/hicolor/scalable/apps
    fi

    for _s in 512 256 128 64 48 32 24 16; do
        if [ -f assets/app-icon/hicolor/${_s}x${_s}/apps/ai.storyteller.texturecraft.png ]; then
            vinstall assets/app-icon/hicolor/${_s}x${_s}/apps/ai.storyteller.texturecraft.png \
                644 usr/share/icons/hicolor/${_s}x${_s}/apps
        fi
    done

    vlicense LICENSE-MIT
    vdoc README.md
}

