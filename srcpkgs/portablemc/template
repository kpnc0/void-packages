# Template file for 'portablemc'
pkgname=portablemc
version=5.0.5
revision=1
build_style=cargo
hostmakedepends="pkg-config"
makedepends="libzstd-devel"
short_desc="Minecraft launcher with Mojang and mod loader support"
maintainer="kpnc0 <xpz4yx@gmail.com>"
license="Apache-2.0"
homepage="https://github.com/theorzr/portablemc"
changelog="https://github.com/theorzr/portablemc/releases"
distfiles="https://static.crates.io/crates/${pkgname}/${pkgname}-${version}.crate"
checksum=bd8558231180f57fefd5c1bc13561df68bae7d67080f43b52b2fa6f57f4fcd0f

do_install() {
    echo "=== RUST_TARGET: '${RUST_TARGET}' ==="
    echo "=== Listing target/ ==="
    ls -la target/ || echo "no target/ dir"
    echo "=== Listing target/${RUST_TARGET}/ ==="
    ls -la "target/${RUST_TARGET}/" 2>&1 || echo "no such dir"
    echo "=== Listing target/${RUST_TARGET}/release/ ==="
    ls -la "target/${RUST_TARGET}/release/" 2>&1 || echo "no such dir"
    echo "=== Finding portablemc executables ==="
    find target -type f -name portablemc 2>&1
    echo "=== Finding any executable named portablemc* ==="
    find target -type f -name 'portablemc*' -perm -0100 2>&1
    exit 1
}
