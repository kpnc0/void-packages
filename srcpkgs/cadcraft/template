# Template file for 'cadcraft'
pkgname=cadcraft
version=0.7.0
revision=1
build_style=cargo
make_build_args="--bins"
depends="libxkbcommon vulkan-loader desktop-file-utils hicolor-icon-theme
 shared-mime-info xdg-utils zenity"
short_desc="Clean-room, Rust-native AutoCAD-compatible CAD application"
maintainer="kpnc0 <xpz4yx@gmail.com>"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps/cadcraft"
distfiles="https://github.com/storytold/cadcraft/archive/refs/tags/v${version}.tar.gz"
checksum=14ec700df561738c23d88be08409523e55a890ef519009e92eff3a5c1f654a63

# Runtime-optimized release profile: fat LTO + single CGU + abort + strip.
# Costs more build RAM/CPU, but produces the fastest, smallest binaries.
export CARGO_PROFILE_RELEASE_LTO=fat
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
export CARGO_PROFILE_RELEASE_PANIC=abort
export CARGO_PROFILE_RELEASE_STRIP=symbols
export CARGO_PROFILE_RELEASE_DEBUG=0
export CARGO_PROFILE_RELEASE_INCREMENTAL=false

# Single cargo invocation: both bins share one dependency graph / link pass.
do_build() {
	cargo auditable build --release --locked --target ${RUST_TARGET} \
		${configure_args} --bins
}

do_install() {
	vbin target/${RUST_TARGET}/release/cadcraft
	vbin target/${RUST_TARGET}/release/cadcraft-cli

	vinstall packaging/linux/ai.storyteller.cadcraft.desktop 644 usr/share/applications
	vinstall packaging/linux/ai.storyteller.cadcraft.mime.xml 644 usr/share/mime/packages

	if [ -f assets/app-icon/hicolor/scalable/apps/ai.storyteller.cadcraft.svg ]; then
		vinstall assets/app-icon/hicolor/scalable/apps/ai.storyteller.cadcraft.svg \
			644 usr/share/icons/hicolor/scalable/apps
	fi
	for _s in 512 256 128 64 48 32 24 16; do
		vinstall assets/app-icon/hicolor/${_s}x${_s}/apps/ai.storyteller.cadcraft.png \
			644 usr/share/icons/hicolor/${_s}x${_s}/apps
	done

	vlicense LICENSE-MIT
	vdoc README.md
}
