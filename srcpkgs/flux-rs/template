# Template file for 'flux-rs'
pkgname=flux-rs
version=0.8.0
revision=1
build_style=cargo
hostmakedepends="pkg-config gettext desktop-file-utils"
makedepends="gtk4-devel libadwaita-devel poppler-glib-devel graphene-devel pango-devel cairo-devel gdk-pixbuf-devel"
depends="ffmpeg ImageMagick icoutils p7zip"
short_desc="Fast GTK4/libadwaita file manager written in Rust"
maintainer="kpnc0 <xpz4yx@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/killown/flux"
distfiles="https://github.com/killown/flux/archive/refs/tags/v${version}.tar.gz"
checksum=badbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadbadb

do_prepare() {
    # libc::malloc_trim exists only on glibc. Gate each call on target_env = "gnu".
    local files
    files=$(grep -rl 'libc::malloc_trim' src || true)
    if [ -z "$files" ]; then
        msg_error "flux-rs: no malloc_trim calls found; upstream changed, update do_prepare.\n"
    fi
    perl -0pi -e 's/libc::malloc_trim\(0\);/#[cfg(target_env = "gnu")] libc::malloc_trim(0);/g' $files
    if grep -rL 'cfg(target_env = "gnu")\] libc::malloc_trim' $files | grep -q .; then
        msg_error "flux-rs: malloc_trim patch did not apply to all files.\n"
    fi
}

do_install() {
    vbin target/release/flux-fm
}
