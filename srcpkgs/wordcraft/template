# Template file for 'wordcraft'
pkgname=wordcraft
version=0.6.1
revision=1
build_style=cargo
make_build_args="--bins"
depends="libxkbcommon vulkan-loader desktop-file-utils hicolor-icon-theme
 shared-mime-info xdg-utils zenity"
short_desc="Clean-room, Rust-native Word-compatible word processor"
maintainer="kpnc0 <xpz4yx@gmail.com>"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps/wordcraft"
distfiles="https://github.com/storytold/wordcraft/archive/refs/tags/v${version}.tar.gz"
checksum=da04df66c0637b7fd9d8b1b0079f8cf91aa8a04dec12fa5426adaca386945a88

export CARGO_PROFILE_RELEASE_LTO=fat
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
export CARGO_PROFILE_RELEASE_OPT_LEVEL=3

do_build() {
    cargo auditable build --release --locked --target ${RUST_TARGET} \
        ${configure_args} --bins
}

do_install() {
    vbin target/${RUST_TARGET}/release/wordcraft
    vbin target/${RUST_TARGET}/release/wordcraft-cli

    vinstall packaging/linux/ai.storyteller.wordcraft.desktop 644 usr/share/applications
    vinstall packaging/linux/ai.storyteller.wordcraft.mime.xml 644 usr/share/mime/packages

    if [ -f assets/app-icon/hicolor/scalable/apps/ai.storyteller.wordcraft.svg ]; then
        vinstall assets/app-icon/hicolor/scalable/apps/ai.storyteller.wordcraft.svg \
            644 usr/share/icons/hicolor/scalable/apps
    fi

    for _s in 512 256 128 64 48 32 24 16; do
        if [ -f assets/app-icon/hicolor/${_s}x${_s}/apps/ai.storyteller.wordcraft.png ]; then
            vinstall assets/app-icon/hicolor/${_s}x${_s}/apps/ai.storyteller.wordcraft.png \
                644 usr/share/icons/hicolor/${_s}x${_s}/apps
        fi
    done

    vlicense LICENSE-MIT
    vdoc README.md
}
