# Template file for 'gridcraft'
pkgname=gridcraft
version=0.5.0
revision=1
build_style=cargo
make_build_args="--bins"
depends="libxkbcommon vulkan-loader desktop-file-utils hicolor-icon-theme
 shared-mime-info xdg-utils zenity"
short_desc="Clean-room, Rust-native spreadsheet application"
maintainer="kpnc0 <xpz4yx@gmail.com>"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps/gridcraft"
distfiles="https://github.com/storytold/gridcraft/archive/refs/tags/v${version}.tar.gz"
checksum=5b36f9f9117c5c9abf0ed12d6be734761802d623130c86b53a95df35a2fe0d35

export CARGO_PROFILE_RELEASE_LTO=fat
export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
export CARGO_PROFILE_RELEASE_OPT_LEVEL=3

do_build() {
	cargo auditable build --release --locked --target ${RUST_TARGET} \
		${configure_args} --bins
}

do_install() {
	vbin target/${RUST_TARGET}/release/gridcraft
	vbin target/${RUST_TARGET}/release/gridcraft-cli

	vinstall packaging/linux/ai.storyteller.gridcraft.desktop 644 usr/share/applications
	vinstall packaging/linux/ai.storyteller.gridcraft.mime.xml 644 usr/share/mime/packages

	if [ -f assets/app-icon/hicolor/scalable/apps/ai.storyteller.gridcraft.svg ]; then
		vinstall assets/app-icon/hicolor/scalable/apps/ai.storyteller.gridcraft.svg \
			644 usr/share/icons/hicolor/scalable/apps
	fi

	for _s in 512 256 128 64 48 32 24 16; do
		if [ -f assets/app-icon/hicolor/${_s}x${_s}/apps/ai.storyteller.gridcraft.png ]; then
			vinstall assets/app-icon/hicolor/${_s}x${_s}/apps/ai.storyteller.gridcraft.png \
				644 usr/share/icons/hicolor/${_s}x${_s}/apps
		fi
	done

	vlicense LICENSE-MIT
	vdoc README.md
}
