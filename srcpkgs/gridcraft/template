# Template file for 'gridcraft'
pkgname=gridcraft
version=0.6.1
revision=1
build_style=cargo
hostmakedepends="cargo"
depends="hicolor-icon-theme"
short_desc="Vibe coded clean-room reimplementation of Microsoft Excel"
maintainer="kpnc0 <xpz4yx@gmail.com>"
license="MIT, Apache-2.0"
homepage="https://getartcraft.com/apps/gridcraft"
distfiles="https://github.com/storytold/gridcraft/archive/refs/tags/v${version}.tar.gz"
checksum=8c3997854e19d385aa00082e3f8de091ed4f65127be0b195cb826b3cb3083380

post_patch() {
	export CARGO_PROFILE_RELEASE_DEBUG=2
	export CARGO_PROFILE_RELEASE_STRIP=false
	export CARGO_PROFILE_RELEASE_LTO=thin
	export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
	export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
}

do_install() {
	vinstall assets/app-icon/hicolor/scalable/apps/ai.storyteller.gridcraft.svg 644 usr/share/icons/hicolor/scalable/apps
	for s in 512 256 128 64 48 32 16; do
		vinstall assets/app-icon/hicolor/${s}x${s}/apps/ai.storyteller.gridcraft.png 644 usr/share/icons/hicolor/${s}x${s}/apps
	done
	vinstall packaging/linux/ai.storyteller.gridcraft.desktop 644 usr/share/applications
	vinstall packaging/linux/ai.storyteller.gridcraft.mime.xml 644 usr/share/mime/packages
	vbin target/release/gridcraft
	vbin target/release/gridcraft-cli
	vlicense LICENSE-APACHE
	vlicense LICENSE-MIT
}
